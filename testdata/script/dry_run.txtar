# SAFETY: invariant 9: a dry run writes nothing to the destination.
mkdir ceph
config
snapshot ceph before.txt
exec synctoceph run --dry-run
stdout 'Dry run: nothing was written to the destination'
stdout 'Would copy 2 files'
stdout 'RESULT    OK \(dry run\)'
snapshot ceph after.txt
cmp before.txt after.txt
! exists ceph/LUMS0001
! exists ceph/.syncToCeph

# dry_run = true in the config does the same.
config dry_run=true
exec synctoceph run
stdout 'Dry run'
! exists ceph/LUMS0001

# The flag overrides the config file.
exec synctoceph run --dry-run=false
stdout 'Copied and verified 2 files'

-- src/LUMS0001/a.txt --
a
-- src/LUMS0001/sub/b.txt --
b
