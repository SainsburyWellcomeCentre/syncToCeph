# SAFETY: invariant 7: source, destination and state must be separate, non-nested folders.
mkdir src/ceph
config destination=$WORK/src/ceph
! exec synctoceph run
stderr 'the source .* and the destination .* overlap'
! exists src/ceph/.syncToCeph
! exists src/ceph/LUMS0001

mkdir ceph
config
env XDG_STATE_HOME=$WORK/ceph/state
! exec synctoceph run
stderr 'the destination .* and the state folder .* overlap'
! exists ceph/.syncToCeph
! exists ceph/LUMS0001
! exists ceph/state

-- src/LUMS0001/a.txt --
a
