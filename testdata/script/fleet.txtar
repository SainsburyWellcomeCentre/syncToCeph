# Every machine writes run summaries into its own folder; fleet reads them all.
mkdir archive
config machine_name=scope-a
exec synctoceph run
config profile=second machine_name=scope-b settle_time=10m
! exec synctoceph --profile second run
stdout 'PARTIAL'
exists archive/scope-a/.syncToCeph/runs/latest.json
exists archive/scope-b/.syncToCeph/runs/latest.json

exec synctoceph fleet
stdout '2 machines in .*archive:'
stdout 'OK        scope-a: last run OK'
stdout 'DEFERRED  scope-b: last run PARTIAL'
stdout '1 file deferred'
exec synctoceph fleet --json --archive $WORK/archive
stdout '"machine_name": "scope-a"'
stdout '"deferred_count": 1'

# A dry run writes no summary into the archive.
config profile=third machine_name=scope-c
exec synctoceph --profile third run --dry-run
! exists archive/scope-c

-- src/a.txt --
a
