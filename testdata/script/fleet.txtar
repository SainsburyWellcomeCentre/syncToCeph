# Every machine writes run summaries under .syncToCeph/<subfolder>/; fleet reads them all.
mkdir ceph
config subfolder=behaviour
exec synctoceph run
config profile=second subfolder=ephys settle_time=10m
! exec synctoceph --profile second run
stdout 'PARTIAL'
exists ceph/.syncToCeph/behaviour/runs/latest.json
exists ceph/.syncToCeph/ephys/runs/latest.json

exec synctoceph fleet
stdout '2 subfolders in .*ceph:'
stdout 'OK        behaviour: last run OK'
stdout 'DEFERRED  ephys: last run PARTIAL'
stdout '1 file deferred'
exec synctoceph fleet --json --destination $WORK/ceph
stdout '"subfolder": "behaviour"'
stdout '"deferred_count": 1'

# A dry run writes no summary to the destination.
config profile=third subfolder=histology
exec synctoceph --profile third run --dry-run
! exists ceph/.syncToCeph/histology

-- src/LUMS0001/a.txt --
a
