# Data copied before synctoceph was used is reported once as unverified.
mkdir archive/scope-01
config
cp src/a.txt archive/scope-01/a.txt
age 2h src/a.txt archive/scope-01/a.txt
exec synctoceph run
stdout 'Nothing new to copy'
stdout '1 file in the archive has the same size and time as the source, but synctoceph has not'
stdout 'Check once with: synctoceph verify'
! exec synctoceph check-archived src
stdout 'UNVERIFIED    a.txt'

# The suggestion is shown once, not on every run.
exec synctoceph run
! stdout 'Check once with'
exec synctoceph status
stdout '1 file in the archive not verified yet'

# verify re-reads both copies and records the match.
exec synctoceph verify
stdout 'Verified 1 file'
stdout 'RESULT    OK: every file checked is verified.'
exec synctoceph check-archived src
stdout 'SAFE'
exec synctoceph run
! stdout 'Check once with'

# SAFETY: invariant 4: a damaged archive copy is found, never reported as verified.
cp damaged.txt archive/scope-01/a.txt
age 2h archive/scope-01/a.txt
! exec synctoceph verify
stdout 'ERROR     1 file in the archive differs from the source'
stdout 'a.txt'

# run --verify all finds it too, and replace mode repairs it (old copy kept).
exec synctoceph run --verify all
stdout '1 file already in the archive differs from the source and was NOT replaced'
exec synctoceph run --verify all --existing replace
stdout 'Copied and verified 1 file'
cmp archive/scope-01/a.txt src/a.txt

-- src/a.txt --
original content
-- damaged.txt --
DAMAGED content!
