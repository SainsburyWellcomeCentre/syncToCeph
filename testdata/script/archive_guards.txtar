# SAFETY: invariant 6: a missing archive folder is an error and is never created.
config
! exec synctoceph run
stdout 'the archive folder .* does not exist'
stdout 'synctoceph never creates the archive folder'
! exists archive

# SAFETY: invariant 6: with require_mount, the archive is used only if it is mounted.
mkdir notamount/lab-archive
config archive=$WORK/notamount/lab-archive require_mount=$WORK/notamount
! exec synctoceph run
stdout 'is not mounted'
stdout 'What to do: mount the share'
! exists notamount/lab-archive/scope-01

# require_mount must contain the archive.
mkdir archive
config require_mount=$WORK/notamount
! exec synctoceph run
stdout 'does not contain the archive'

# The exit code for FAILED is 1.
exec sh -c 'synctoceph run >/dev/null; test $? -eq 1'

-- src/a.txt --
a
