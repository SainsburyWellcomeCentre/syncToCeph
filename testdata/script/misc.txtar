# version, completion and --json outputs.
exec synctoceph version
stdout '^synctoceph dev \(commit unknown, built unknown, go1\.'
exec synctoceph version --json
stdout '"schema_version": 2'
exec synctoceph completion bash
stdout 'bash completion V2 for synctoceph'
exec synctoceph completion zsh
stdout '#compdef synctoceph'
! exec synctoceph completion fish
stderr 'unsupported shell'

# Read-only commands never create the state folder.
exec synctoceph status
stdout 'State:      idle'
stdout 'Last run:   none yet'
exec synctoceph logs
stdout 'The log is empty'
exec synctoceph stop
stdout 'Nothing is running'
exec synctoceph status --json
stdout '"running": false'
! exists home/.local/state/synctoceph

# -q prints only the result.
mkdir ceph
config
exec synctoceph run -q
! stdout 'Scanning'
stdout '^RESULT    OK'

# -v lists every file copied and verified (rsync's raw lines are in the log).
cp src/LUMS0001/a.txt src/LUMS0001/b.txt
exec synctoceph run -v
stdout '\[1/1\] copied    LUMS0001/b.txt'
stdout '\[1/1\] verified  LUMS0001/b.txt'
! stdout '>f\+\+\+'
exec synctoceph logs -n 200
stdout '>f\+\+\+\+\+\+\+\+\+ b.txt'
! exec synctoceph run -v -q
stderr 'cannot be used together'

# logs --run shows the lines of one run.
exec synctoceph logs --json
stdout '"lines": \['

# The state folder must not be on a Windows drive.
env XDG_STATE_HOME=/mnt/z/state
! exec synctoceph run
stderr 'is on a Windows drive'

-- src/LUMS0001/a.txt --
a
