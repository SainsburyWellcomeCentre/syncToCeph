# check-copied answers "is it safe to delete this from the acquisition PC?"
mkdir ceph
config exclude=["Thumbs.db"]
exec synctoceph run
stdout 'Copied and verified 2 files'
exec synctoceph check-copied src/LUMS0001/session1
stdout 'SAFE: every file under src/LUMS0001/session1 \(1 file\) is copied to ceph and verified'

# A new file makes the folder unsafe to delete; the exit code is 1.
cp src/LUMS0001/session1/a.tif src/LUMS0001/session1/new.tif
! exec synctoceph check-copied src/LUMS0001/session1
stdout 'NOT-COPIED    LUMS0001/session1/new.tif'
stdout 'NOT SAFE: 1 of 2 files under src/LUMS0001/session1 is not verified on ceph'
stdout 'Not copied: run synctoceph run.'

# Excluded files, and files outside an animal folder, are never copied, so
# they are never "safe".
! exec synctoceph check-copied src
stdout 'EXCLUDED      LUMS0001/Thumbs.db'
stdout 'SKIPPED       notes.txt'

# Paths outside the source are refused.
! exec synctoceph check-copied ceph
stderr 'is not inside the source folder'

exec synctoceph check-copied --json src/LUMS0001/other.txt
stdout '"all_verified": true'

-- src/LUMS0001/session1/a.tif --
a
-- src/LUMS0001/other.txt --
other
-- src/LUMS0001/Thumbs.db --
thumbnail cache
-- src/notes.txt --
not in an animal folder
